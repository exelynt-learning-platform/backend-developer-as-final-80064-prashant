            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?page=0&size=10&sortBy=createdAt&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortDir",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Reservations with Filters (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?status=CONFIRMED&minPrice=50.00&maxPrice=1000.00&page=0&size=10&sortBy=totalPrice&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                {
                  "key": "status",
                  "value": "CONFIRMED"
                },
                {
                  "key": "minPrice",
                  "value": "50.00"
                },
                {
                  "key": "maxPrice",
                  "value": "1000.00"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "totalPrice"
                },
                {
                  "key": "sortDir",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Reservation By ID (User/Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
